# SLAYERS Environment Configuration

# Application
PROJECT_NAME="SLAYERS"
DATABASE_URL="sqlite:///./slayers.db"
API_PREFIX="/api"

# AI Provider Configuration
# Set to 'gemini', 'openai', or 'auto' (falls back to rule-based engine if no keys provided)
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Stock & Visual Asset Search Providers (Optional)
# Wikimedia Commons API runs out-of-the-box with ZERO API key required!
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
